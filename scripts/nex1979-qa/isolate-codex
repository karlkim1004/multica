#!/bin/sh
set -eu
[ "$#" = 0 ] || exit 64
root=/opt/nex1979-qa
# Only the system executables and named QA files cross the mount boundary.
# The private network namespace has loopback only and no host sockets.
exec "$root/bwrap" --unshare-all --die-with-parent --new-session \
    --uid 65534 --gid 65534 --cap-drop ALL --clearenv \
    --ro-bind /usr /usr --tmpfs /usr/local \
    --symlink usr/bin /bin --symlink usr/lib /lib --symlink usr/lib64 /lib64 \
    --proc /proc --dev /dev --tmpfs /tmp --perms 1777 --tmpfs /home --dir /work \
    --ro-bind "$root/fixture.py" /qa/fixture.py \
    --ro-bind "$root/probe.py" /qa/probe.py \
    --ro-bind "$root/multica-cli" /qa/multica \
    --setenv HOME /home/qa --setenv CODEX_HOME /home/qa/.codex \
    --setenv SHELL /bin/bash --setenv PATH /usr/bin:/bin --setenv LANG C.UTF-8 --chdir /work \
    -- /usr/bin/python3 -I /qa/fixture.py
